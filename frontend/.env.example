# UnnatiSetu.ai Frontend Environment Variables
# Copy this file to .env and fill in your values.
# Only VITE_ prefixed variables are exposed to the browser bundle.
# NEVER put secret keys (service_role, SARVAM_API_KEY) here.

# ── Backend API URL (required for production) ────────────────────────────────
# Set to your deployed Render backend URL (e.g., https://your-backend.onrender.com)
# Leave empty for local development (uses Vite dev proxy).
VITE_API_URL=

# ── Supabase (anon key only — safe for browser) ──────────────────────────────
# These values match the backend .env.example SUPABASE_URL and SUPABASE_ANON_KEY.
# Without these, the admin dashboard runs in offline demo mode (no auth required).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
