# UnnatiSetu.ai Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Sarvam AI ───────────────────────────────────────────────────────────────
# Required for voice input (STT), language identification, structured field
# extraction, translation, and text-to-speech features.
# Sign up at https://dashboard.sarvam.ai to get your API key.
# Without this key the app falls back to manual text entry and rule-based NLP.
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Supabase ─────────────────────────────────────────────────────────────────
# Required to persist applicant data, scheme rules, recommendations, and
# enable NSFDC admin authentication.
# Create a free project at https://supabase.com/dashboard
#
# SUPABASE_URL:              Found in Project Settings → API → Project URL
# SUPABASE_ANON_KEY:         Found in Project Settings → API → anon/public key
#                            (safe to expose in frontend; RLS enforces access)
# SUPABASE_SERVICE_ROLE_KEY: Found in Project Settings → API → service_role key
#                            KEEP THIS SECRET — backend only, never expose to browser.
#
# Without these vars the app falls back to in-memory data (demo mode).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── FastAPI Server (optional) ────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000

# ── CORS (required for production) ───────────────────────────────────────────
# Set to your deployed frontend URL (e.g., https://your-app.vercel.app)
# Without this, CORS defaults to localhost origins for development only.
FRONTEND_URL=
